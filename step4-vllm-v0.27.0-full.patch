+        q_group=int(q_group),
+        topk_windows=int(topk_windows),
+        topk_width=_next_power_of_2(int(topk_windows)),
+        max_union_windows=int(max_union_windows),
+        num_region_bins=int(num_region_bins),
+        bit_words=int(bit_words),
