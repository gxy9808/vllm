+    block_topk_idx_ptr,
+    query_start_loc_ptr,
+    request_indices_ptr,
+    valid_rows_ptr,
+    seq_lens_ptr,
+    req_block_offsets_ptr,
+    block_table_ptr,
+    out_counts_ptr,
+    out_packed_indices_ptr,
+    stride_blk_q,
+    stride_blk_w,
+    stride_bt_req,
+    stride_bt_page,
+    stride_out_counts_q,
+    stride_out_packed_q,
+    stride_out_packed_w,
+    num_reqs,
+    total_windows,
+    SORT_OUTPUT: tl.constexpr,
+    HAS_REQUEST_INDICES: tl.constexpr,
+    HAS_VALID_ROWS: tl.constexpr,
+    SEARCH_STEPS: tl.constexpr,
+):
+    q_idx = tl.program_id(0)
