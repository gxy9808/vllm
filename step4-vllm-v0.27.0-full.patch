+    global_blk = tl.load(
+        block_topk_idx_ptr + q_idx * stride_blk_q + win * stride_blk_w,
+        mask=win < history_windows,
+        other=-1,
+    ).to(tl.int32)
+    local_blk = global_blk - block_offset
