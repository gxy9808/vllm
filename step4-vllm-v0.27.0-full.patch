+            work_q_input_local,
+            work_q_local,
+            work_q_len,
+            causal_limits,
+        ) = self._validate_inputs(
+            q,
+            k_cache,
+            v_cache,
+            o,
+            lse,
+            union_phys_indices,
+            union_logical_indices,
+            union_counts,
+            exact_mask_bits,
+            work_q_global,
+            work_q_input_local,
+            work_q_local,
+            work_q_len,
