+    num_kv_head: int,
+    rotary_dim: int,
+    eps: float = 1e-5,
+    norm_weight_bias: float = 1.0,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    return _fused_qknorm_rope_forward_impl(
