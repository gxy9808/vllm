+        Int64,
+        ptr.toint(),
+        tensor.memspace,
+        assumed_align=min(ptr.max_alignment, 8),
+    )
+    src = cute.make_tensor(int_ptr, cute.make_layout((1,), stride=(1,)))
+    return src[0]
