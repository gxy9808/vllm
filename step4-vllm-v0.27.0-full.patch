+    query_start_loc_ptr,
+    request_indices_ptr,
+    valid_rows_ptr,
+    seq_lens_ptr,
+    req_block_offsets_ptr,
+    block_table_ptr,
+    out_counts_ptr,
+    out_packed_indices_ptr,
+    stride_blk_q,
+    stride_blk_w,
