+def prewarm_csa_compact_prefill_update_with_slots_sm90_gqa(
+    *,
+    device: torch.device | str,
+    index_dtype: torch.dtype,
+    head_dim: int,
+    summaries_per_page: int,
+    sum_page_stride: int,
+    count_page_stride: int,
+    region_block_size: int,
