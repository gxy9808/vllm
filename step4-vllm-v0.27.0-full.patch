+        candidate_idx.detach(), alignment=16, dynamic_shape_dim=0
+    )
+    launch = _make_launch_topk_selector_streaming_kernel(
+        topk=int(topk),
+        stable_sort=bool(stable_sort),
+        source_kind=str(source_kind),
