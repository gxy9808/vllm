+    block_size,
+    window,
+    HAS_REQUEST_INDICES: tl.constexpr,
+    HAS_VALID_ROWS: tl.constexpr,
+    SEARCH_STEPS: tl.constexpr,
+    BLOCK_W: tl.constexpr,
+):
+    q_idx = tl.program_id(0)
