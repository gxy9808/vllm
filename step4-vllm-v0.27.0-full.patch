+            raise ValueError(
+                "GQA MTP union exact-mask decode wrapper supports only logical_q_heads in "
+                f"{_TokenWiseSparseDecodeMTPUnionExactMaskGQA.SUPPORTED_LOGICAL_Q_HEADS}, "
+                f"got {self.logical_q_heads}"
