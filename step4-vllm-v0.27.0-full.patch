+    tile_query_start_loc,
+    tile_seq_lens,
+    work_q_global,
+    work_q_local,
+    work_q_len,
+    num_reqs,
+    total_groups,
+    Q_GROUP: tl.constexpr,
+) -> None:
+    group = tl.program_id(0)
+    running = tl.full((), 0, tl.int32)
+    found = tl.full((), False, tl.int1)
+    out_global = tl.full((), 0, tl.int32)
+    out_local = tl.full((), 0, tl.int32)
+    out_len = tl.full((), 0, tl.int32)
