+            g_z_ptr = elem_pointer(mIndexZ, (matched_row, 0, channel_base))
+            g_k_ptr = cute.make_ptr(
+                mIndexK.element_type,
+                g_k_ptr.toint(),
+                mIndexK.memspace,
+                assumed_align=16,
+            )
+            g_z_ptr = cute.make_ptr(
+                mIndexZ.element_type,
+                g_z_ptr.toint(),
+                mIndexZ.memspace,
+                assumed_align=16,
+            )
