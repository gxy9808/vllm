+        Int32(block_table.shape[1]),
+        Int32(summary.shape[0]),
+        Int32(summaries_per_page),
+        Int32((max_regions + PAGED_TILE_KV - 1) // PAGED_TILE_KV),
+        Int32(query_rows * ((max_regions + PAGED_TILE_KV - 1) // PAGED_TILE_KV)),
