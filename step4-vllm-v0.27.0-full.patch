+    if int(q_group) != expected:
+        raise ValueError(
+            "GQA grouped-union prefill requires "
+            f"q_group={expected} when q_heads_per_kv={int(q_heads)}, "
+            f"got q_group={int(q_group)}"
+        )
+    return int(q_group)
