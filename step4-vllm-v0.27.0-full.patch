+        "stride_blk_w",
+        "stride_bt_req",
+        "stride_bt_page",
+        "stride_out_counts_q",
+        "stride_out_packed_q",
+        "stride_out_packed_w",
+        "num_reqs",
+        "total_windows",
+    ],
+    do_not_specialize_on_alignment=_DECODE_META_ALIGNMENT_DYNAMIC_ARGS,
