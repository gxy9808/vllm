+        query_start_loc_ptr,
+        request_indices_ptr,
+        seq_lens_ptr,
+        req_block_offsets_ptr,
+        q_idx,
+        block_size,
+        num_reqs,
+        HAS_REQUEST_INDICES=HAS_REQUEST_INDICES,
+        SEARCH_STEPS=SEARCH_STEPS,
+    )
