+@cute.kernel
+def _merge_mtp_union_exact_mask_nat_lse_states_kernel_gqa(
+    mPartialOut: cute.Tensor,
+    mPartialLSE: cute.Tensor,
+    mOut: cute.Tensor,
+    mLSE: cute.Tensor,
+    batch: Int32,
+    num_heads: Int32,
+    head_dim: Int32,
+):
+    batch_idx, head_idx, _ = cute.arch.block_idx()
+    tidx, _, _ = cute.arch.thread_idx()
