+        staged_values = tl.load(
+            active_token_k + staged_offsets,
+            mask=dim_mask & use_staged,
+            other=0.0,
+        ).to(tl.float32)
+        staged_logits = tl.load(
+            active_token_z + staged_z_offsets,
+            mask=dim_mask & use_staged,
+            other=-float("inf"),
+        ).to(tl.float32)
