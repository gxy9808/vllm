+@dsl_user_op
+def store_fp8x8(
+    tensor: cute.Tensor, coord: cute.Coord, packed: Int64, *, loc=None, ip=None
+) -> None:
+    ptr = elem_pointer(tensor, coord, loc=loc, ip=ip).align(8)
+    int_ptr = cute.make_ptr(
+        Int64,
+        ptr.toint(),
+        tensor.memspace,
+        assumed_align=min(ptr.max_alignment, 8),
