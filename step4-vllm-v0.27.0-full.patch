+def _expected_union_q_group(q_heads: int) -> int:
+    if int(q_heads) == 4:
+        return 32
+    if int(q_heads) == 8:
+        return 16
+    if int(q_heads) == 16:
+        return 8
+    raise ValueError(
+        f"GQA grouped-union prefill supports q_heads in (4, 8, 16), got {int(q_heads)}"
+    )
