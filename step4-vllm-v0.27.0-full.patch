+    tl.store(
+        out_packed_indices_ptr
+        + q_idx * stride_out_packed_q
+        + win * stride_out_packed_w,
+        packed,
+        mask=mask,
+    )
+    tl.store(
+        out_counts_ptr + q_idx * stride_out_counts_q,
+        tl.sum(sorted_valid.to(tl.int32), axis=0),
+    )
