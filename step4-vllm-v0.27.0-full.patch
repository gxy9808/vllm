+    local_blk_safe = tl.where(local_valid, local_blk, 0)
+    local_page_idx = local_blk_safe // 2
+    local_phys_page = tl.load(
+        block_table_ptr + req_idx * stride_bt_req + local_page_idx * stride_bt_page,
+        mask=local_valid,
+        other=0,
+    ).to(tl.int32)
