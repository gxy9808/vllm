+    assert all(
+        call["inputs_embeds"].shape == (num_tokens, 4)
+        and call["inputs_embeds"].data_ptr() == proposer.inputs_embeds.data_ptr()
+        and call["hidden_states"].shape == (num_tokens, 4)
+        for call in model_calls
+    )
