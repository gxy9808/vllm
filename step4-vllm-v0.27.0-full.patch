+    stream_fake = cute.runtime.make_fake_stream(use_tvm_ffi_env_stream=True)
+    compiled = cute.compile(
+        launch,
+        mInput,
+        mOutIdx,
+        mStarts,
+        mEnds,
+        mCandidateIdx,
+        1,
+        1,
+        1,
+        1,
+        stream_fake,
+        options="--enable-tvm-ffi --opt-level 2",
