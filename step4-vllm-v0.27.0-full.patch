+            (1,), int(index_q.shape[0]), dtype=torch.int32, device=index_q.device
+        )
+    if valid_tokens is None:
+        valid_tokens = torch.full(
+            (1,),
+            int(index_q.shape[0]) * q_len,
+            dtype=torch.int32,
