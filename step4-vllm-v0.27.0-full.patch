+        block_table,
+        row_req_idx,
+        row_table_idx,
+        row_starts,
+        row_ends.reshape(-1),
+        q_runtime,
+        kernel_weights,
+        out,
+        valid_requests,
+        valid_tokens,
+    )
+    return out
