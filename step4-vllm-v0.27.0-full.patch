+        s_z_ptr = elem_pointer(sIndexZ, (token_offset, channel_base))
+        s_k_ptr = cute.make_ptr(
+            mIndexK.element_type,
+            s_k_ptr.toint(),
+            sIndexK.memspace,
+            assumed_align=16,
+        )
+        s_z_ptr = cute.make_ptr(
+            mIndexZ.element_type,
+            s_z_ptr.toint(),
+            sIndexZ.memspace,
+            assumed_align=16,
+        )
